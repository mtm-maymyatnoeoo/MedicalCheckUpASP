@model MedicalCheckUpASP.ViewModels.EmployeeCheckupVM

@{
    Layout = "_MedicalLayout";
    ViewData["title"] = "Create New Employee";
}

<div class="container mt-4 w-100" style="max-width: 1400px">
    <div class="card shadow-sm bg-custom-purple">
        <div class="card-header text-white bg-custom-heavy-purple">
            <h4 class="mb-0">Create New Employee</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "Employee", FormMethod.Post, new { id= "employeeForm", @class = "row mb-3" }))
            {
                <div class="row g-2">

                    <!-- Remove Button -->
                    @* <button id="removeProfileImage" type="button" class="remove-btn">Remove</button> *@
                    <!-- First Column -->
                    <div class="col-md-2 col-sm-12">
                        <!-- Profile -->
                        <div class="col-md-12 col-sm-12">
                            <div class="profile-preview">
                                <img src="~/images/default-profile.png" id="profileImagePreview" alt="Profile Picture" />
                            </div>
                            <!-- File Input  -->
                            <input type="file" name="ProfileImage" style="display: none;" class="form-control" id="profileImageInput" accept="image" />
                            @Html.ValidationMessageFor(m => m.Employee.ProfileImage, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- Name -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.Name, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label> <!-- Add the asterisk manually -->
                            @Html.TextBoxFor(m => m.Employee.Name, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Employee.Name, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- Employee Number -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.EmployeeNumber, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label>
                            @Html.TextBoxFor(m => m.Employee.EmployeeNumber, new { @class = "form-control", placeholder = "E00347 or E-00347" })
                            @Html.ValidationMessageFor(m => m.Employee.EmployeeNumber, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- Position -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.Position, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label> <!-- Add the asterisk manually -->
                            @Html.TextBoxFor(m => m.Employee.Position, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Employee.Position, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- NRC -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.NRC, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label> <!-- Add the asterisk manually -->
                            @Html.TextBoxFor(m => m.Employee.NRC, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Employee.NRC, "", new { @class = "text-danger custom-error-message" })
                        </div>
                    </div>
                    <!-- Second Column -->
                    <div class="col-md-2 col-sm-12" style="margin-top:168px">
                        <!-- DOB -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.DOB, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label> <!-- Add the asterisk manually -->
                            @Html.TextBoxFor(m => m.Employee.DOB, new { @class = "form-control", type="date"})
                            @Html.ValidationMessageFor(m => m.Employee.DOB, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- Entry Date -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.EntryDate, new { @class = "form-label fw-bold" })
                            <label class="fw-bold text-danger">*</label> <!-- Add the asterisk manually -->
                            @Html.TextBoxFor(m => m.Employee.EntryDate, new { @class = "form-control", type="date"})
                            @Html.ValidationMessageFor(m => m.Employee.EntryDate, "", new { @class = "text-danger custom-error-message" })
                        </div>
                        <!-- Resign Date -->
                        <div class="col-md-12 col-sm-12">
                            @Html.LabelFor(m => m.Employee.ResignDate, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Employee.ResignDate, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Employee.ResignDate, "", new { @class = "text-danger custom-error-message" })
                        </div>
                    </div>

                    <div class="col-md-8 col-sm-12">
                        <div>
                            <h4 style="text-align:center">Medical Checkup History</h4>
                            <!-- Add checkup history button -->
                            <div class="col col-sm-12 pt-4 text-end">
                                <button id="addCheckupHistory" type="button" class="btn btn-light" data-bs-toggle="modal" data-bs-target="#inputHistoryModal">
                                    <i class="fas fa-plus"></i>
                                    Add Checkup History
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.CheckupHistories, "", new { @class = "text-danger custom-error-message" })

                            <!-- Load Modal Partial View -->
                            @Html.Partial("_CheckupHistoryModal")
                        </div>
                        <div class="row">
                            @Html.Partial("_CheckupHistoryList", Model.CheckupHistories)
                        </div>
                    </div>
                </div>
                <!-- Buttons -->

                <div class="col-12 d-flex justify-content-center gap-2 mt-5">
                    <a href="@Url.Action("Index", "Users")" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn bg-custom-heavy-purple px-4 text-white">Save</button>
                    @Html.Raw("<input type='reset' value='Clear' class='btn btn-secondary' />")
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {

    <script>

        // Trigger file input when image is clicked
        $('#profileImagePreview').click(function () {
            $('#profileImageInput').click();
        });

        // Trigger when file is select
        $('#profileImageInput').on('change', function (event) {
            var reader = new FileReader();
            reader.onload = function () {
                $('#profileImagePreview').attr('src', reader.result);
            };
            reader.readAsDataURL(event.target.files[0]);
        });

        // Remove the image and reset the file input
        $('#removeProfileImage').click(function () {
            $('#profileImagePreview').attr('src', '~/images/default-profile.png'); // Reset to default image
            $('#profileImageInput').val(''); // Clear the file input
            $(this).hide(); // Hide the remove button
        });

        $(document).ready(function(){

            // Requrire Validation and Date Validation
            function checkValidation() {
                 var selectedPackageIndex = $("#packageDropdown option:selected").index()
                 var checkupDate = $("#CheckupDate").val().trim();
                 if ( selectedPackageIndex == 0 || checkupDate == '') {
                    $('#validation-errors').text("Fill Require Fields");
                    return false;
                 } else {
                     var deadlineDate = $("#DeadlineDate").val().trim();
                     if (deadlineDate != "" && new Date(deadlineDate) < new Date(checkupDate)) {
                        $('#validation-errors').html("Checkup date must be greater than deadline date.");
                        return false;

                     }

                 }
                 return true;
            }

            // Initialize DataTable
            var table = $('#checkupHistoryTable').DataTable({
                "scrollY": "400px", // Set the height you want
                "scrollCollapse": true, // Allows the table to reduce its height when fewer rows exist
                "paging": false, // Disable pagination if you want to show all rows
                "searching": false,
                "ordering": false,
            });

            // DatePicker
            $('.datepicker').datepicker({
                format: 'mm-dd-yyyy',  // Format for date selection
                startDate: '-15y',  // Optional: Start date limit
                endDate: '+15y',  // Optional: End date limit
                autoclose: true,  // Close the datepicker once a date is selected
                clearBtn: true, // Enable 'Clear' button
                allowInputToggle: true // Allows manual input of date
            });

            // Trigger add history button on modal
            $("#btn-add-history").on("click", function () {
                var selectedPackageText = $("#packageDropdown option:selected").text();
                var selectedPackageValue = $("#packageDropdown option:selected").val();
                var checkupDate = $("#CheckupDate").val().trim();
                var deadlineDate = $("#DeadlineDate").val().trim();

                var isVaccine = $("#chkIsVaccine").prop("checked");
                var isCheck = $("#chkIsCheck").prop("checked");
                var isCancel = $("#chkIsCancel").prop("checked");
                var isAdminConfirm = $("#chkAdminConfirm").prop("checked");

                var vaccine = isVaccine? "checked" : "unchecked";
                var check = isCheck? "checked" : "unchecked";
                var cancel = isCancel? "checked" : "unchecked";
                var adminConfirm = isAdminConfirm? "checked" : "unchecked";

                // var isVaccine = $("#chkIsVaccine").prop("checked")? "Yes" : "No";
                // var isCheck = $("#chkIsCheck").prop("checked")? "Yes" : "No";
                // var isCancel = $("#chkIsCancel").prop("checked")? "Yes" : "No";
                // var adminConfirm = $("#chkAdminConfirm").prop("checked")? "Yes" : "No";
                if (checkValidation()) {
                    let rowIndex = $("#checkupHistoryTable tbody tr.history-row").length;
                            // Add a new row with indexed hidden inputs
                    let newRowHtml = `
                        <tr class="history-row">
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].PackageText" value="${selectedPackageText}" />
                                <input type="hidden" name="CheckupHistories[${rowIndex}].PackageId" value="${selectedPackageValue}" />
                                ${selectedPackageText}
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].CheckupDate" value="${checkupDate}" />
                                ${checkupDate}
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].DeadlineDate" value="${deadlineDate}" />
                                ${deadlineDate}
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].IsVaccine" value="${isVaccine}" />
                               <input type="checkbox" disabled ${vaccine} />
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].CheckFlg" value="${isCheck}" />
                                <input type="checkbox" disabled ${check} />
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].IsCancel" value="${isCancel}" />
                                <input type="checkbox" disabled ${cancel} />
                            </td>
                            <td>
                                <input type="hidden" name="CheckupHistories[${rowIndex}].IsAdminConfirm" value="${isAdminConfirm}" />
                                <input type="checkbox" disabled ${adminConfirm} />
                            </td>
                            <td>
                                <button type="button" class="btn deleteBtn btn-danger btn-sm">Delete</button>
                            </td>
                        </tr>`;

                    // Append row to DataTable and form
                    let newRow = $(newRowHtml).appendTo("#checkupHistoryTable tbody");
                    table.row.add(newRow).draw(false);


                    // table.row.add([
                    //     selectedPackageText,
                    //     checkupDate,
                    //     deadlineDate,
                    //     isVaccine,
                    //     isCheck,
                    //     isCancel,
                    //     adminConfirm,
                    //     '<button type="button" class="btn deleteBtn btn-danger btn-sm">Delete</button>'
                    // ]).draw(false);
                            // Add a custom class to the newly added row
                    // $(table.row(':last').node()).addClass('history-row');

                    // Clear input fields
                    clearInputs();
                    $("#inputHistoryModal").modal("hide");
                }
            });

            // Delete event with event delegation
            $(document).on("click", ".deleteBtn", function () {
                var row = $(this).closest("tr");
                var rowIndex = row.index();  // Get the index of the row to delete
                table.row(row).remove().draw(false); // Remove it from DataTable properly (both internal storage and from table)
                // After removing the row, update all remaining rows' index values
                $("#checkupHistoryTable tbody tr.history-row").each(function (newIndex) {
                    // Update the name attributes for inputs in each remaining row
                     $(this).find("input[name^='CheckupHistories']").each(function () {
                     var currentName = $(this).attr("name");
                     // Replace the old index with the new one
                     var newName = currentName.replace(/\[\d+\]/, `[${newIndex}]`);
                     $(this).attr("name", newName);
                     });
                });
            });

            // Form validation and custom validation
            $("#employeeForma").on("submit", function (e) {
                console.log("Submit")
                 // Prevent form submission to handle validation
                e.preventDefault();
                console.log("VALIDA")
                        // Clear previous custom error messages
                $(".error-message").html('');
                        // Perform HTML5 validation (required, pattern, etc.)
                if (!this.checkValidity()) {
                    // If HTML5 validation fails, the browser will automatically show errors
                    return; // Prevent further processing, since HTML5 validation is handled automatically
                }
                var isValid = true;
                // Custom validation logic for other fields
                var errors = [];
                if ( $("#checkupHistoryTable tbody tr.history-row").length == 0 ){
                    errors.push("Checkup Required");
                }
                        // Display errors for each field
                if (errors.length > 0) {
                    errors.forEach(function (error) {
                        if (error.includes("Checkup Required")) {
                            $('#history-error').text("Add checkup histories.");
                        }
                    });
                    isValid = false;
                }
                // If all validations pass, proceed with form submission
                if (isValid) {
                    alert("Form submitted successfully!");
                   // this.submit(); // Uncomment to submit the form
                } else {
                    return;
                }

            });

        });

        // Trigger when modal is show
        // Binding package dropdownlist
        $("#inputHistoryModal").on("shown.bs.modal", function () {
            $.ajax({
                url: "@Url.Action("GetPackages", "Employee")", // Change controller if needed
                type: "GET",
                success: function (data) {
                    var dropdown = $("#packageDropdown");
                    dropdown.empty(); // Clear existing options
                    dropdown.append('<option value="">Select a Package</option>'); // Default option
                    $.each(data, function (index, item) {
                        dropdown.append($('<option></option>').val(item.value).text(item.text));
                    });
                },
                error: function () {
                    alert("Error loading packages");
                }
            });

            // clear controls
            clearInputs();
        });

        // When closing the modal, move focus back to the triggering element
        $("#inputHistoryModal").on("hidden.bs.modal", function () {
            $("#btn-add-history").focus(); // Move focus to a button outside the modal
        });
        function clearInputs(){
            $("#DeadlineDate, #CheckupDate").val("");
            $('#validation-errors').text("");
            $("#chkIsVaccine").prop("checked", false);
            $("#chkIsCheck").prop("checked", true);
            $("#chkIsCancel").prop("checked", false);
            $("#chkAdminConfirm").prop("checked", true);
        }


 

    </script>
}

@section Styles {
    <style>
        .profile-preview {
            width: 150px;
            height: 150px;
            border: 2px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 5px auto;
        }

        .profile-preview img {
            width: auto;
            height: 100%;
            object-fit: contain; /* Ensures the entire image fits inside the box while maintaining aspect ratio
            max-width: 100%;
            max-height: 100%;
        }

        .remove-btn {
            background-color: red;
            color: white;
            border: none;
            padding: 4px 8px;
            font-size: 10px;
            border-radius: 5px;
            cursor: pointer;
            margin: 5px 5px;
        }

        /* Make the checkbox larger */
        .custom-checkbox {
            width: 30px; /* Increase width */
            height: 30px; /* Increase height */
            margin-left: 10px; /* Adjust space between checkbox and label */
        }
        /* Custom check color */
        .custom-checkbox:checked {
            background-color: #28a745; /* Green background when checked */
            border-color: #28a745; /* Green border when checked */
        }

        .custom-checkbox:checked:after {
            background-color: #fff; /* White checkmark */
        }

        .custom-checkbox:not(:checked) {
            background-color: #ddd; /* Light grey when unchecked */
            border-color: #bbb; /* Grey border */
        }

    </style>
}